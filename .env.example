# Provedor de LLM: "openai" (endpoint OpenAI-compatible)
LLM_PROVIDER=openai
LLM_MODEL=<nome-do-modelo>
LLM_TEMPERATURE=0.2
LLM_BASE_URL=http://<host>:<porta>/v1/

# Servidor MCP externo (Streamable HTTP)
MCP_SERVER_URL=http://<host>:8787/mcp

# API HTTP
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Chave do provedor
OPENAI_API_KEY=

# Segredo entre backends (>=32 caracteres), igual ao do DisplayQuest e MCP.
QUESTAI_INTEGRATION_TOKEN=
